<?xml version="1.0" encoding="utf-8"?>
<!--
  Hand-authored golden: a topologically CORRECT XORSplitAutomation fragment for
  target task_1 "Test Task" (upstream start_1, downstream end_1). Authored from
  CLAUDE.md §4 by hand — deliberately NOT generated by apply_pattern — so it is
  an independent source of truth the oracle is validated against. The oracle keys
  on topology, not these ids; the ids follow the transform's convention only for
  human readability. Full DI so the golden is 0-error, 0-warning.

    start_1 ─flow_in─► gw1 ─bot_branch─► task_1_bot ─bot_to_gw2─► gw2 ─bot_success─► gw4 ─exit─► end_1
                        │                                          └─bot_failure─► gw3          ▲
                        └─human_branch────────────────────────────────────────► gw3 ─to_human─► task_1 ─flow_out─┘
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    id="def_golden">
  <bpmn:process id="proc_1" isExecutable="true">
    <bpmn:startEvent id="start_1"/>
    <bpmn:task id="task_1" name="Test Task"/>
    <bpmn:endEvent id="end_1"/>
    <bpmn:task id="task_1_bot" name="Auto Test Task"/>
    <bpmn:exclusiveGateway id="task_1_auto_gw1" name="Bot or Human?"/>
    <bpmn:exclusiveGateway id="task_1_auto_gw2" name="Bot succeeded?"/>
    <bpmn:exclusiveGateway id="task_1_auto_gw3" name="Human needed"/>
    <bpmn:exclusiveGateway id="task_1_auto_gw4" name="Exit"/>
    <bpmn:sequenceFlow id="flow_in"  sourceRef="start_1"     targetRef="task_1_auto_gw1"/>
    <bpmn:sequenceFlow id="flow_out" sourceRef="task_1"      targetRef="task_1_auto_gw4"/>
    <bpmn:sequenceFlow id="task_1_auto_bot_branch"   name="bot"     sourceRef="task_1_auto_gw1" targetRef="task_1_bot"/>
    <bpmn:sequenceFlow id="task_1_auto_human_branch" name="human"   sourceRef="task_1_auto_gw1" targetRef="task_1_auto_gw3"/>
    <bpmn:sequenceFlow id="task_1_auto_bot_to_gw2"             sourceRef="task_1_bot"      targetRef="task_1_auto_gw2"/>
    <bpmn:sequenceFlow id="task_1_auto_bot_success"  name="success" sourceRef="task_1_auto_gw2" targetRef="task_1_auto_gw4"/>
    <bpmn:sequenceFlow id="task_1_auto_bot_failure"  name="failure" sourceRef="task_1_auto_gw2" targetRef="task_1_auto_gw3"/>
    <bpmn:sequenceFlow id="task_1_auto_to_human"              sourceRef="task_1_auto_gw3" targetRef="task_1"/>
    <bpmn:sequenceFlow id="task_1_auto_exit"                  sourceRef="task_1_auto_gw4" targetRef="end_1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram_1">
    <bpmndi:BPMNPlane id="plane_1" bpmnElement="proc_1">
      <bpmndi:BPMNShape id="start_1_di" bpmnElement="start_1">
        <dc:Bounds x="100" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_1_di" bpmnElement="task_1">
        <dc:Bounds x="440" y="380" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_1_di" bpmnElement="end_1">
        <dc:Bounds x="760" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_1_bot_di" bpmnElement="task_1_bot">
        <dc:Bounds x="320" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_1_auto_gw1_di" bpmnElement="task_1_auto_gw1" isMarkerVisible="true">
        <dc:Bounds x="220" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_1_auto_gw2_di" bpmnElement="task_1_auto_gw2" isMarkerVisible="true">
        <dc:Bounds x="480" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_1_auto_gw3_di" bpmnElement="task_1_auto_gw3" isMarkerVisible="true">
        <dc:Bounds x="360" y="395" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_1_auto_gw4_di" bpmnElement="task_1_auto_gw4" isMarkerVisible="true">
        <dc:Bounds x="620" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_in_di" bpmnElement="flow_in">
        <di:waypoint x="136" y="218"/>
        <di:waypoint x="220" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_out_di" bpmnElement="flow_out">
        <di:waypoint x="540" y="420"/>
        <di:waypoint x="645" y="245"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_1_auto_bot_branch_di" bpmnElement="task_1_auto_bot_branch">
        <di:waypoint x="245" y="195"/>
        <di:waypoint x="320" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_1_auto_human_branch_di" bpmnElement="task_1_auto_human_branch">
        <di:waypoint x="245" y="245"/>
        <di:waypoint x="385" y="395"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_1_auto_bot_to_gw2_di" bpmnElement="task_1_auto_bot_to_gw2">
        <di:waypoint x="420" y="220"/>
        <di:waypoint x="480" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_1_auto_bot_success_di" bpmnElement="task_1_auto_bot_success">
        <di:waypoint x="530" y="220"/>
        <di:waypoint x="620" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_1_auto_bot_failure_di" bpmnElement="task_1_auto_bot_failure">
        <di:waypoint x="505" y="245"/>
        <di:waypoint x="400" y="410"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_1_auto_to_human_di" bpmnElement="task_1_auto_to_human">
        <di:waypoint x="410" y="420"/>
        <di:waypoint x="440" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_1_auto_exit_di" bpmnElement="task_1_auto_exit">
        <di:waypoint x="670" y="220"/>
        <di:waypoint x="760" y="218"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
